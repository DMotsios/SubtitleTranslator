<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="24dp" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="English → Greek subtitles" android:textSize="24sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="24dp"/>
<Button android:id="@+id/startButton" android:text="START TRANSLATION" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/stopButton" android:text="STOP" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
<TextView android:id="@+id/status" android:text="Stopped" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"/>
</LinearLayout>
